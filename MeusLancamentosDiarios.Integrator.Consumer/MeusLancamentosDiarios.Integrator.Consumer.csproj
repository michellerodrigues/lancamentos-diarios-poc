<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MeusLancamentosDiarios.Integrator.Consumer-cc70a429-5519-4e63-9c28-bc48f7c6c714</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeusLancamentosDiarios.Integrator.Events\MeusLancamentosDiarios.Integrator.Events.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Detalhes internos ficam visiveis ao projeto de teste correspondente, para
         nao precisar tornar publico o que so existe por razao de implementacao. -->
    <InternalsVisibleTo Include="MeusLancamentosDiarios.Integrator.Consumer.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- O .Events tambem e executavel e tem appsettings.json proprio. Pela referencia
       de projeto ele viria junto no publish e disputaria o caminho com o desta
       aplicacao (NETSDK1152). Fica so o daqui. -->
  <Target Name="IgnorarAppsettingsDasReferencias" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('appsettings')) and '%(ResolvedFileToPublish.RootDir)%(ResolvedFileToPublish.Directory)' != '$([MSBuild]::EnsureTrailingSlash($(MSBuildProjectDirectory)))'" />
    </ItemGroup>
  </Target>

</Project>
