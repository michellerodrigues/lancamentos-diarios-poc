<?xml version="1.0" encoding="utf-8"?>
<!--
  Esta POC não consome nenhum pacote interno.
  O <clear /> descarta as origens herdadas do NuGet.config global (incluindo o
  feed privado Agro_Feed do Azure DevOps, que exige credencial), evitando 401 no restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
