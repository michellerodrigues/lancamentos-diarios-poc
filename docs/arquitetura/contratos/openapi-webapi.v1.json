      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Troca o ID token do Google pela sessao. Cadastra no primeiro acesso.",
        "operationId": "LoginGoogle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginGoogleCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoResponse"
                }
              }
