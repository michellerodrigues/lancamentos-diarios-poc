  "paths": {
    "/auth/eu": {
      "get": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "O dono do token, com a conta e a role.",
        "description": "**Acesso:** ClienteOuAdmin.",
        "operationId": "UsuarioAtual",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/saldo/{contaId}": {
      "get": {
        "tags": [
          "Saldo"
        ],
        "summary": "Saldo consolidado da conta, pendentes e saldo projetado.",
        "description": "**Acesso:** ClienteOuAdmin + posse da conta.",
        "operationId": "ObterSaldo",
        "parameters": [
          {
            "name": "contaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limitePendentes",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaldoResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/contas": {
      "get": {
        "tags": [
          "Saldo"
        ],
        "summary": "Contas que ja receberam algum lancamento.",
        "description": "**Acesso:** SomenteAdmin.",
        "operationId": "ListarContas",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/auth/registrar": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Cadastro com e-mail e senha. Cria a conta do usuario e ja devolve a sessao.",
        "operationId": "Registrar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarUsuarioCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
