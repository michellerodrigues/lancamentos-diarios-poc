    "/lancamentos": {
      "post": {
        "tags": [
          "Lancamentos"
        ],
        "summary": "Registra um lancamento na conta. A consolidacao e assincrona.",
        "description": "**Acesso:** ClienteOuAdmin + posse da conta.",
        "operationId": "CriarLancamento",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarLancamentoCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CriarLancamentoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
