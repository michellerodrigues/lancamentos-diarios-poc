      "get": {
        "tags": [
          "Lancamentos"
        ],
        "summary": "Consulta um lancamento e em que estagio da esteira ele esta.",
        "description": "**Acesso:** ClienteOuAdmin + posse da conta.",
        "operationId": "ObterLancamento",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
