              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/auth/redefinir-senha": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Define a senha nova com o token do e-mail. Encerra todas as sessoes abertas.",
        "operationId": "RedefinirSenha",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedefinirSenhaCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
