    "/auth/sair": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Logout: revoga o token de renovacao.",
        "operationId": "Sair",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EncerrarSessaoCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/esqueci-senha": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Manda o link de redefinicao, se o e-mail tiver cadastro. Local: veja no Mailpit (:8025).",
