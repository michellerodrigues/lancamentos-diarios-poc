pan style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;Passado&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;na&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;Request&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;participant&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;as&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;Backend&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; (&lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;API&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;Note&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;over&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BFF&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; Ambos possuem a MESMA Chave Secreta Guardada (Simétrica)&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #9650c8;font-weight: bold;&quot;&gt;rect&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;rgb&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;(240, 248, 255)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;Note&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;over&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BFF&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; 1. GERAÇÃO (Criação)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BFF&lt;/span&gt;&lt;span style=&quot;color: #008800;font-weight: bold;&quot;&gt;-&amp;gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BFF&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; Dados Legíveis + Chave Secreta = Assinatura (HS256)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #9650c8;font-weight: bold;&quot;&gt;end&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BFF&lt;/span&gt;&lt;span style=&quot;color: #008800;font-weight: bold;&quot;&gt;-&amp;gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;: 2. &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;Envia&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;JWT&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;no&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;Header&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; (&lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;Authorization&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; Bearer xxx)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #9650c8;font-weight: bold;&quot;&gt;rect&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;rgb&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;(245, 245, 220)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;Note&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;over&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; 3. VALIDAÇÃO (Verificação)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #008800;font-weight: bold;&quot;&gt;-&amp;gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; Dados do JWT + Mesma Chave Secreta = Nova Assinatura&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #008800;font-weight: bold;&quot;&gt;-&amp;gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; Nova Assinatura == Assinatura do Token?&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #9650c8;font-weight: bold;&quot;&gt;end&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;Note&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #649696;&quot;&gt;over&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;BE&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;: ✅ &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;Se&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #a22889;&quot;&gt;igual&lt;/span&gt;&lt;span style=&quot;color: #000000;font-weight: bold;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #aa8500;&quot;&gt; Token é autêntico e confiável!&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;" vertex="1">
